# =============================================================================
# TrackCam Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------- App
ENVIRONMENT=development
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------- CORS
# Comma-separated list. Must match your running frontend's origin exactly.
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------- Database
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://trackcam:trackcam@localhost:5432/trackcam
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=false

# ------------------------------------------------------------- Model paths
# Paths are relative to the backend/ working directory unless absolute.
# If a file does not exist, the corresponding module reports
# MODEL_NOT_AVAILABLE instead of producing fabricated results.
YOLO_MODEL_PATH=models/yolo11n.pt
PLATE_MODEL_PATH=models/plate.pt
REID_MODEL_PATH=models/osnet_x0_25.pt
LSTM_MODEL_PATH=models/traffic_lstm.pt

# --------------------------------------------------------- AI thresholds
CONFIDENCE_THRESHOLD=0.5
STATIONARY_THRESHOLD_SECONDS=300
CONGESTION_THRESHOLD_VEHICLES=350
TRAVEL_TIME_THRESHOLD_MULTIPLIER=1.5
QUEUE_GROWTH_RATE_THRESHOLD=0.4

# ------------------------------------------------------ Video processing
FRAME_SKIP=2
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# ------------------------------------------------------------- Device
# Set true to force CPU inference even if a CUDA GPU is available.
FORCE_CPU=false

# ------------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_JSON=false

# ------------------------------------------------------------- WebSocket
WS_HEARTBEAT_SECONDS=30
